    {
      "id": 11,
      "title": "Proof failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(neutrin0_block_proof_total{outcome=\"failed\",instance=~\"${instance:regex}\"}[15m])",
          "legendFormat": "{{instance}} block"
        },
        {
          "refId": "B",
          "expr": "increase(neutrin0_chunk_proof_total{outcome=\"failed\",instance=~\"${instance:regex}\"}[15m])",
          "legendFormat": "{{instance}} chunk"
        },
        {
          "refId": "C",
          "expr": "increase(neutrin0_fact_proof_total{outcome=\"failed\",instance=~\"${instance:regex}\"}[15m])",
          "legendFormat": "{{instance}} fact"
        },
        {
          "refId": "D",
          "expr": "increase(neutrin0_evidence_proof_total{outcome=\"failed\",instance=~\"${instance:regex}\"}[15m])",
          "legendFormat": "{{instance}} evidence"
        },
        {
          "refId": "E",
          "expr": "increase(neutrin0_program_setup_total{outcome=\"failed\",instance=~\"${instance:regex}\"}[15m])",
          "legendFormat": "{{instance}} program_setup"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
