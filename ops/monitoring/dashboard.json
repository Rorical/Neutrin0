      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"neutrin0_proving_(inflight|waiters)\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{instance}} {{stage}} {{phase}} {{kind}} {{outcome}} {{__name__}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
