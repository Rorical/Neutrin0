      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "neutrin0_sync_full_chunk_cursor{instance=~\"${instance:regex}\"} and on(instance,job) neutrin0_sync_full_chunk_enabled == 1 and on(instance,job) neutrin0_sync_progress_available == 1 and on(instance,job) neutrin0_sync_full_chunk_target_available == 1",
          "legendFormat": "{{instance}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Download cursors are shown only when full chunk sync is enabled and local progress plus the authenticated target are known. Inspect availability panels for Unknown or Disabled."
    },
    {
      "id": 17,
