      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Peers / connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
