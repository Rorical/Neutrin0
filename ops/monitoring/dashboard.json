        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "neutrin0_bft_session_stake{instance=~\"${instance:regex}\"}",
          "legendFormat": "{{instance}} slot {{slot}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Proof latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,instance)(rate(neutrin0_block_proof_seconds_bucket{instance=~\"${instance:regex}\"}[15m])))",
          "legendFormat": "{{instance}} block_proof"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le,instance)(rate(neutrin0_chunk_proof_seconds_bucket{instance=~\"${instance:regex}\"}[15m])))",
          "legendFormat": "{{instance}} chunk_proof"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95,sum by(le,instance)(rate(neutrin0_fact_proof_seconds_bucket{instance=~\"${instance:regex}\"}[15m])))",
          "legendFormat": "{{instance}} fact_proof"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.95,sum by(le,instance)(rate(neutrin0_evidence_proof_seconds_bucket{instance=~\"${instance:regex}\"}[15m])))",
          "legendFormat": "{{instance}} evidence_proof"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
